Package: HRRI
Type: Package
Title: Diagnostics for Soil-Plant-Microbial Redox Recovery
Version: 1.0.5
Date: 2026-09-12
Authors@R: c(
    person("Mitra", "Ghotbi",
           email = "mitra.ghotbi@gmail.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-9185-9993")),
